# ------------------------------------------------------------------------------
# Database Settings (Supabase PostgreSQL Connection)
# ------------------------------------------------------------------------------
# The direct connection URL or connection pool URL from your Supabase Dashboard
DB_URL=jdbc:postgresql://db.psotqdkpduaerahxbfbh.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# ------------------------------------------------------------------------------
# A base64-encoded 256-bit HMAC key (minimum 32 bytes)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiry Durations (in milliseconds)
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 Days

# ------------------------------------------------------------------------------
# Server Ports
# ------------------------------------------------------------------------------
SERVER_PORT=8080
VITE_API_URL=http://localhost:8080/api/v1
