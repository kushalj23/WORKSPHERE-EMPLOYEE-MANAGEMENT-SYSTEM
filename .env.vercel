# ==============================================================================
# WorkSphere Frontend - Vercel Environment Variables
# ==============================================================================
# ⚠️ IMPORTANT:
# - Do NOT commit this file to your git repository if you fill in secrets.
# - In the Vercel Dashboard, go to your project -> Settings -> Environment Variables.
# - Add the following key-value pair:

# Point this to your deployed Spring Boot backend URL on Render, Railway, or AWS.
# Make sure the URL ends with "/api/v1" and does NOT contain a trailing slash.
# Example: https://worksphere-backend.onrender.com/api/v1
VITE_API_URL=https://YOUR_DEPLOYED_BACKEND_URL.onrender.com/api/v1
